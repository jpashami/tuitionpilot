# TuitionPilot — copy to .env.local (never commit real values)

# Claude API (agent)
ANTHROPIC_API_KEY=

# GoBTC Pay
GOBTC_BASE_URL=https://api.gobtcpay.com/public/api/v1.2
# Merchant (the demo "university bursar") — filled by scripts/merchant-*.mjs
GOBTC_MERCHANT_MNEMONIC=
GOBTC_MERCHANT_XPUB=
GOBTC_MERCHANT_FINGERPRINT=
GOBTC_MERCHANT_ID=
GOBTC_SK_LIVE=
# Agent payer wallet — filled by scripts/payer-key.mjs and scripts/wallet-register.mjs
GOBTC_PAYER_PRIVKEY_HEX=
GOBTC_PAYER_PUBKEY_HEX=
GOBTC_PAYER_ADDRESS=

# App behaviour
# Real mainnet submission only when "true"; otherwise the agent stops after building the PSBT.
PAYMENTS_ENABLED=false
# Invoice amount × scale = amount actually paid in the demo (0.0002 → CAD 8,450 becomes CAD 1.69)
DEMO_AMOUNT_SCALE=0.0002
# Optional overrides
# TUITIONPILOT_DB=./tuitionpilot.db
# TUITIONPILOT_UPLOADS=./uploads
# Simulated bursar off-ramp fee (%) used for the CAD settlement view
OFFRAMP_FEE_PCT=1
